{
  "name": "rak-golden-visa",
  "version": "1.0.0",
  "private": true,
  "description": "RAK Golden Visa - Next.js website with full admin CMS and customer portal",
  "scripts": {
    "dev": "next dev",
    "setup": "prisma generate && prisma db push --skip-generate && node prisma/seed.mjs",
    "build": "prisma generate && next build",
    "db:prepare": "prisma db push --skip-generate && node prisma/seed.mjs",
    "start": "npm run db:prepare && next start",
    "start:cpanel": "node server.js",
    "seed": "node prisma/seed.mjs",
    "seed:reset": "node prisma/seed.mjs --force",
    "create-admin": "node prisma/create-admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.7",
    "nodemailer": "^7.0.6",
    "prisma": "^6.16.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
